<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <Appenders>
        <RollingFile name="file" fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}json-logger-test-app.log"
                     filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}json-logger-test-app-%i.log">
            <PatternLayout pattern="%-5p %d [%t] %c: %m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
        <RollingFile name="json" fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}json-only.log"
                     filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}json-only-%i.log">
            <PatternLayout pattern="%m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <AsyncLogger name="org.mule.extension.jsonlogger" level="DEBUG" additivity="false"><AppenderRef ref="json"/></AsyncLogger>
        <AsyncLogger name="com.example.audit" level="INFO" additivity="false"><AppenderRef ref="json"/></AsyncLogger>
        <AsyncLogger name="org.mule.extension.jsonlogger.internal" level="WARN"><AppenderRef ref="file"/></AsyncLogger>
        <AsyncRoot level="INFO"><AppenderRef ref="file"/></AsyncRoot>
    </Loggers>
</Configuration>
